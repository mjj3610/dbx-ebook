{
  "name": "dbx-ebook",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "DBX 电子书阅读器插件：18 种格式、单/双页/滚动、听书、翻译、高亮笔记、备份同步",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/mjj3610/dbx-ebook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjj3610/dbx-ebook.git"
  },
  "bugs": {
    "url": "https://github.com/mjj3610/dbx-ebook/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "pack": "dbx-plugin package . --output-dir release",
    "pack:ci": "dbx-plugin package . --output-dir dist",
    "doctor": "dbx-plugin dev --path . --port 5190",
    "fixtures": "node scripts/make-fixtures.mjs",
    "e2e": "node scripts/e2e.mjs",
    "host-smoke": "node scripts/host-smoke.mjs",
    "host-flow": "node scripts/host-flow.mjs",
    "dir-storage": "node scripts/dir-storage.mjs",
    "shots": "node scripts/screenshots.mjs",
    "backend": "go build -C backend -trimpath -o ../bin/backend-dev.exe .",
    "backend:check": "node scripts/sidecar-check.mjs",
    "cmap": "node scripts/gen-pdfjs-assets.mjs",
    "host-pdf": "node scripts/host-pdf.mjs",
    "host-picker": "node scripts/host-picker.mjs",
    "store:candidate": "node scripts/make-store-candidate.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@dbx-app/plugin-cli": "^0.1.9",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
